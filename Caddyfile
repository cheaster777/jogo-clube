{$SITE_SCHEME}{$SITE_ADDRESS} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' https://static.cloudflareinsights.com; connect-src {$CSP_CONNECT_SRC} https://static.cloudflareinsights.com https://cloudflareinsights.com;"
    }

    # Behind the Cloudflare tunnel, Caddy always receives plain HTTP. This header
    # tells whether the visitor used HTTPS, which the install prompt and the
    # secure session cookie require.
    @plainHttp header X-Forwarded-Proto http
    redir @plainHttp https://{host}{uri} permanent

    @api path /api/* /health/*
    handle @api {
        reverse_proxy api:3001
    }

    @immutableAssets {
        path /assets/*
        file {
            root /srv
        }
    }
    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

    @entrypoint path / /index.html /service-worker.js /manifest.json
    header @entrypoint Cache-Control "no-cache"

    # Without this, a missing asset would receive index.html, and Cloudflare
    # would cache that HTML under the asset URL.
    @missingAsset {
        path /assets/*
        not file {
            root /srv
        }
    }
    handle @missingAsset {
        header Cache-Control "no-store"
        respond 404
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# The previous domain only sends visitors to the current one.
{$SITE_SCHEME}{$LEGACY_SITE_ADDRESS:legacy.localhost} {
    # A cached service worker keeps serving the old page and never reaches the
    # redirect, so this replacement removes itself and reloads the open tabs.
    handle /service-worker.js {
        header Content-Type "text/javascript; charset=utf-8"
        header Cache-Control "no-cache"
        respond `self.addEventListener("install", () => self.skipWaiting());
self.addEventListener("activate", (event) => event.waitUntil((async () => {
  await self.clients.claim();
  await self.registration.unregister();
  const tabs = await self.clients.matchAll({ type: "window" });
  await Promise.all(tabs.map((tab) => tab.navigate(tab.url)));
})()));
`
    }

    handle {
        redir https://{$SITE_ADDRESS}{uri} permanent
    }
}
