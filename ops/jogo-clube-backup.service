[Unit]
Description=Backup criptografado do PostgreSQL do Jogo Clube
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=clubeciencia
Group=clubeciencia
WorkingDirectory=/srv/clubeciencia
EnvironmentFile=/etc/jogo-clube/backup.env
ExecStart=/bin/bash /srv/clubeciencia/scripts/backup-postgres.sh
