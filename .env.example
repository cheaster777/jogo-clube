# Copie para .env (dev) ou .env.production (VPS, fora do Git) e ajuste os valores.
# Referência completa: docs/OPERATIONS.md e server/config.ts (fonte da verdade dos defaults).

# ---- Frontend (Vite, build-time) ----
# Caminho base que o app compilado usa para chamar a API. Em dev local com
# `npm run dev` + `npm run server:dev`, o proxy padrão espera /api/v1.
VITE_API_BASE_URL=/api/v1

# ---- Núcleo da API ----
NODE_ENV=development
PORT=4000

# Postgres. Em dev local, aponte para uma instância própria; em produção via
# Docker Compose, use o hostname do serviço "db" (não publique a porta 5432).
DATABASE_URL=postgres://jogo_clube:jogo_clube@localhost:5432/jogo_clube
DATABASE_SSL=false

# Origens autorizadas a chamar a API (separadas por vírgula, sem espaço extra).
CORS_ORIGIN=http://localhost:3000

# URL pública do frontend, usada para montar links de verificação/reset de senha.
APP_BASE_URL=http://localhost:3000

# true atrás de proxy reverso (Caddy) em produção; necessário para IP/cookie corretos.
TRUST_PROXY=false

# ---- Sessão / cookies ----
COOKIE_SECURE=false
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=2592000

# Nunca deixe true em produção (o loadConfig já força false quando NODE_ENV=production).
# Serve para testar fluxo de reset/verificação sem SMTP em dev.
RESET_TOKEN_EXPOSE=true

# ---- Limites e rate limit ----
JSON_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
COMMAND_RATE_LIMIT_MAX=60

# ---- Email ----
# console: loga no stdout, só para dev. smtp: obrigatório em produção.
EMAIL_MODE=console
EMAIL_FROM=Clube de Ciências <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TOKEN_TTL_SECONDS=86400

# ---- Docker Compose (produção, perfil backend) ----
SITE_ADDRESS=jogo.exemplo.com
CSP_CONNECT_SRC='self'
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=jogo_clube
POSTGRES_USER=jogo_clube
POSTGRES_PASSWORD=

# ---- Backup criptografado (ops/jogo-clube-backup.timer) ----
# Configurado à parte em /etc/jogo-clube/backup.env na VPS, nunca aqui.
# Ver docs/BACKUP_RESTORE.md. Chave privada age nunca entra neste arquivo.
# BACKUP_AGE_RECIPIENT=age1...

# ---- Testes ----
# Opcional: define TEST_DATABASE_URL para rodar os testes de integração com
# PostgreSQL real (tests/server/postgres.integration.cases.ts). Sem ela, esses
# testes ficam skipped e `npm test` roda normalmente.
# TEST_DATABASE_URL=postgres://jogo_clube:jogo_clube@localhost:5432/jogo_clube_test
